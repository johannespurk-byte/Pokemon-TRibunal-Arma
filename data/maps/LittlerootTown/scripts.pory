// ====================================================================
// MAP SCRIPTS & TRANSITIONS (WURZELHEIM ORIGINAL)
// ====================================================================

mapscripts LittlerootTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LittlerootTown_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LITTLEROOT_INTRO_STATE, 1: LittlerootTown_EventScript_StepOffTruckMale
        VAR_LITTLEROOT_INTRO_STATE, 2: LittlerootTown_EventScript_StepOffTruckFemale
        VAR_DEX_UPGRADE_JOHTO_STARTER_STATE, 1: LittlerootTown_EventScript_BeginDexUpgradeScene
    ]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_DEX_UPGRADE_JOHTO_STARTER_STATE, 1: LittlerootTown_EventScript_SetRivalBirchPosForDexUpgrade
    ]
}

script LittlerootTown_OnTransition {
    setflag(FLAG_VISITED_LITTLEROOT_TOWN)
    call(Common_EventScript_SetupRivalGfxId)
    if (var(VAR_LITTLEROOT_INTRO_STATE) == 2) {
        call(LittlerootTown_EventScript_MoveMomToMaysDoor)
    }
    if (!flag(FLAG_RESCUED_BIRCH)) {
        call(LittlerootTown_EventScript_SetTwinPos)
    }
    if (var(VAR_LITTLEROOT_TOWN_STATE) == 3) {
        call(LittlerootTown_EventScript_SetMomStandingInFrontOfDoorPos)
    }
    if (var(VAR_LITTLEROOT_HOUSES_STATE_MAY) == 4) {
        call(LittlerootTown_EventScript_SetExitedHouseAfterLatiSSTicketEvent)
    }
    if (var(VAR_LITTLEROOT_HOUSES_STATE_BRENDAN) == 4) {
        call(LittlerootTown_EventScript_SetExitedHouseAfterLatiSSTicketEvent)
    }
    if (var(VAR_OLDALE_RIVAL_STATE) == 1) {
        call(LittlerootTown_EventScript_MoveRivalFromOldale)
    }
    if (var(VAR_LITTLEROOT_RIVAL_STATE) == 3) {
        call(LittlerootTown_EventScript_SetRivalLeftForRoute103)
    }
    if (var(VAR_DEX_UPGRADE_JOHTO_STARTER_STATE) == 1) {
        call(LittlerootTown_EventScript_HideMapNamePopup)
    }
    if (var(VAR_DEX_UPGRADE_JOHTO_STARTER_STATE) == 2) {
        call(LittlerootTown_EventScript_LeftLabAfterDexUpgrade)
    }
    end
}

// ====================================================================
// STANDARD NPC EVENT SCRIPTS
// ====================================================================

script LittlerootTown_EventScript_Twin {
    lock
    faceplayer
    if (flag(FLAG_ADVENTURE_STARTED)) {
        goto(LittlerootTown_EventScript_GoodLuck)
    }
    if (flag(FLAG_RESCUED_BIRCH)) {
        goto(LittlerootTown_EventScript_YouSavedBirch)
    }
    if (var(VAR_LITTLEROOT_TOWN_STATE) != 0) {
        goto(LittlerootTown_EventScript_GoSaveBirch)
    }
    msgbox(LittlerootTown_Text_IfYouGoIntoGrassPokemonWillPopOut, MSGBOX_DEFAULT)
    release
    end
}

script LittlerootTown_EventScript_GoodLuck {
    msgbox(LittlerootTown_Text_GoodLuck, MSGBOX_DEFAULT)
    release
    end
}

script LittlerootTown_EventScript_YouSavedBirch {
    msgbox(LittlerootTown_Text_YouSavedBirch, MSGBOX_DEFAULT)
    release
    end
}

script LittlerootTown_EventScript_GoSaveBirch {
    msgbox(LittlerootTown_Text_GoSaveBirch, MSGBOX_DEFAULT)
    release
    end
}

script LittlerootTown_EventScript_FatMan {
    msgbox(LittlerootTown_Text_CanUsePCToStoreItems, MSGBOX_NPC)
    end
}

script LittlerootTown_EventScript_Boy {
    msgbox(LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC)
    end
}

script LittlerootTown_EventScript_Mom {
    lock
    faceplayer
    release
    end
}

// ====================================================================
// CUTSCENE STEPS & MOVEMENTS
// ====================================================================

script LittlerootTown_EventScript_StepOffTruckMale {
    lockall
    setvar(VAR_0x8004, 5)
    setvar(VAR_0x8005, 8)
    call(LittlerootTown_EventScript_GoInsideWithMom)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_TRUCK)
    warpsilent(MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_1F, 8, 8)
    waitstate
    releaseall
    end
}

script LittlerootTown_EventScript_StepOffTruckFemale {
    lockall
    setvar(VAR_0x8004, 14)
    setvar(VAR_0x8005, 8)
    call(LittlerootTown_EventScript_GoInsideWithMom)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_TRUCK)
    warpsilent(MAP_LITTLEROOT_TOWN_MAYS_HOUSE_1F, 2, 8)
    waitstate
    releaseall
    end
}

script LittlerootTown_EventScript_GoInsideWithMom {
    delay(15)
    playse(SE_LEDGE)
    applymovement(LOCALID_PLAYER, LittlerootTown_Movement_PlayerStepOffTruck)
    waitmovement(0)
    opendoor(VAR_0x8004, VAR_0x8005)
    waitdooranim
    addobject(LOCALID_LITTLEROOT_MOM)
    applymovement(LOCALID_LITTLEROOT_MOM, LittlerootTown_Movement_MomExitHouse)
    waitmovement(0)
    closedoor(VAR_0x8004, VAR_0x8005)
    waitdooranim
    delay(10)
    applymovement(LOCALID_LITTLEROOT_MOM, LittlerootTown_Movement_MomApproachPlayerAtTruck)
    waitmovement(0)
    msgbox(LittlerootTown_Text_OurNewHomeLetsGoInside, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_LITTLEROOT_MOM, LittlerootTown_Movement_MomApproachDoor)
    applymovement(LOCALID_PLAYER, LittlerootTown_Movement_PlayerApproachDoor)
    waitmovement(0)
    opendoor(VAR_0x8004, VAR_0x8005)
    waitdooranim
    applymovement(LOCALID_LITTLEROOT_MOM, LittlerootTown_Movement_MomEnterHouse)
    applymovement(LOCALID_PLAYER, LittlerootTown_Movement_PlayerEnterHouse)
    waitmovement(0)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
    setvar(VAR_LITTLEROOT_INTRO_STATE, 3)
    hideplayer
    closedoor(VAR_0x8004, VAR_0x8005)
    waitdooranim
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_FAT_MAN)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    return
}

script LittlerootTown_EventScript_BeginDexUpgradeScene {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_LITTLEROOT_BIRCH, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(80)
    msgbox(LittlerootTown_Text_BirchSomethingToShowYouAtLab, MSGBOX_DEFAULT)
    closemessage
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_RIVAL)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BIRCH)
    delay(20)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    warp(MAP_LITTLEROOT_TOWN_PROFESSOR_BIRCHS_LAB, 6, 5)
    waitstate
    releaseall
    end
}

script LittlerootTown_EventScript_SetRivalBirchPosForDexUpgrade {
    addobject(LOCALID_LITTLEROOT_BIRCH)
    addobject(LOCALID_LITTLEROOT_RIVAL)
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        setobjectxy(LOCALID_LITTLEROOT_RIVAL, 6, 10)
        setobjectxy(LOCALID_LITTLEROOT_BIRCH, 5, 10)
    } else {
        setobjectxy(LOCALID_LITTLEROOT_RIVAL, 13, 10)
        setobjectxy(LOCALID_LITTLEROOT_BIRCH, 14, 10)
    }
    end
}

// ====================================================================
// HELPER UTILITIES
// ====================================================================

script LittlerootTown_EventScript_LeftLabAfterDexUpgrade {
    setvar(VAR_DEX_UPGRADE_JOHTO_STARTER_STATE, 3)
    return
}

script LittlerootTown_EventScript_HideMapNamePopup {
    setflag(FLAG_HIDE_MAP_NAME_POPUP)
    return
}

script LittlerootTown_EventScript_SetRivalLeftForRoute103 {
    setflag(FLAG_RIVAL_LEFT_FOR_ROUTE103)
    return
}

script LittlerootTown_EventScript_MoveRivalFromOldale {
    setvar(VAR_OLDALE_RIVAL_STATE, 2)
    setflag(FLAG_HIDE_OLDALE_TOWN_RIVAL)
    return
}

script LittlerootTown_EventScript_SetExitedHouseAfterLatiSSTicketEvent {
    setvar(VAR_LITTLEROOT_HOUSES_STATE_MAY, 5)
    setvar(VAR_LITTLEROOT_HOUSES_STATE_BRENDAN, 5)
    return
}

script LittlerootTown_EventScript_MoveMomToMaysDoor {
    setobjectxyperm(LOCALID_LITTLEROOT_MOM, 14, 8)
    return
}

script LittlerootTown_EventScript_SetTwinPos {
    if (var(VAR_LITTLEROOT_TOWN_STATE) == 0) {
        setobjectxyperm(LOCALID_LITTLEROOT_TWIN, 7, 2)
        setobjectmovementtype(LOCALID_LITTLEROOT_TWIN, MOVEMENT_TYPE_FACE_DOWN)
    } else {
        setobjectxyperm(LOCALID_LITTLEROOT_TWIN, 10, 1)
        setobjectmovementtype(LOCALID_LITTLEROOT_TWIN, MOVEMENT_TYPE_FACE_UP)
    }
    return
}

script LittlerootTown_EventScript_SetMomStandingInFrontOfDoorPos {
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
    setobjectmovementtype(LOCALID_LITTLEROOT_MOM, MOVEMENT_TYPE_FACE_DOWN)
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        setobjectxyperm(LOCALID_LITTLEROOT_MOM, 5, 9)
    } else {
        setobjectxyperm(LOCALID_LITTLEROOT_MOM, 14, 9)
    }
    return
}

