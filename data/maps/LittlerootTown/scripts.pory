// ====================================================================
// DEIN GACHA-NPC SYSTEM (FIXED & SAUBER)
// ====================================================================

script LittlerootTown_EventScript_GachaNPC {
    lock
    faceplayer
    msgbox(LittlerootTown_Text_GachaIntro, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox("Schade... Komm wieder, wenn du Lust auf ein Risiko hast!", MSGBOX_DEFAULT)
        release
        end
    }
    
    // Öffnet das Beeren-Menü. Die ID landet im GBA-Ram
special(BagMenu_ChooseBerry)
    waitstate
    
    // Kopiert die gewaehlte Beeren-ID in eine sichere Variable fuer das Poryscript-if
    copyvar(VAR_RESULT, var_item_id)
    
    if (var(VAR_RESULT) == 0) {
        msgbox("Du hast keine Beere ausgewaehlt.", MSGBOX_DEFAULT)
        release
        end
    }

    // Zieht die Beere ab (gespeichert in var_item_id)
    removeitem(var_item_id, 1)
    msgbox(LittlerootTown_Text_GachaTakeBerry, MSGBOX_DEFAULT)

    // --- GEWINNSTUFEN ---
    random(100)
    if (var(VAR_RESULT) < 50) {
        random(3)
        switch (var(VAR_RESULT)) {
            case 0: giveitem(ITEM_POKE_BALL)
            case 1: giveitem(ITEM_POTION)
            case 2: giveitem(ITEM_ANTIDOTE)
        }
        release
        end
    }
    if (var(VAR_RESULT) < 90) {
        random(3)
        switch (var(VAR_RESULT)) {
            case 0: giveitem(ITEM_RARE_CANDY)
            case 1: giveitem(ITEM_NUGGET)
            case 2: giveitem(ITEM_ULTRA_BALL)
        }
        release
        end
    }
    
    // --- POKEMON JACKPOT ---
    random(NUM_SPECIES)
    if (var(VAR_RESULT) == SPECIES_NONE) {
        setvar(VAR_TEMP_1, SPECIES_BULBASAUR)
    } else {
        copyvar(VAR_TEMP_1, VAR_RESULT)
    }
    
    bufferspeciesname(STR_VAR_1, VAR_TEMP_1)
    msgbox("Unglaublich! Du hast den Hauptgewinn gezogen! Ein Pokemon!", MSGBOX_DEFAULT)
    
    givemon(VAR_TEMP_1, 5, ITEM_NONE)
    
    switch (var(VAR_RESULT)) {
        case 0:
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("{PLAYER} erhaelt das Pokemon!", MSGBOX_DEFAULT)
        case 1:
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("{PLAYER} erhaelt das Pokemon!", MSGBOX_DEFAULT)
            msgbox("Das Pokemon wurde auf den PC uebertragen.", MSGBOX_DEFAULT)
        case 2:
            msgbox("Du hast keinen Platz im Team und deine PC-Boxen sind voll?!", MSGBOX_DEFAULT)
    }
    release
    end
}

// ====================================================================
// STYLE CHANGER REFERENCE FIX
