script OldaleTown_Mart_EventScript_Woman {
    lock
    faceplayer
    msgbox("Dieser Supermarkt hat neuerdings ganz\nverrueckte Luxus-Gegenstaende!", MSGBOX_DEFAULT)
    release
    end
}

script OldaleTown_Mart_EventScript_Boy {
    lock
    faceplayer
    msgbox("Hast du auch so viel Geld auf der\nhohen Kante wie dieser neue Trainer?", MSGBOX_DEFAULT)
    release
    end
}
